{
  "name": "zhurong-admin-ui-v3",
  "version": "3.0.0",
  "description": "智碳能源管理系统 - 现代化重构版",
  "author": "LionLi",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:test": "vue-tsc --noEmit && vite build --mode test",
    "build:prod": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.js --fix",
    "lint:check": "eslint . --ext .vue,.ts,.js",
    "format": "prettier --write \"src/**/*.{vue,ts,js,json,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,json,scss,md}\"",
    "stylelint": "stylelint \"src/**/*.{vue,scss}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "vue-tsc --noEmit",
    "prepare": "husky install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@antv/g2": "^5.1.20",
    "@iconify-json/ep": "^1.1.19",
    "@iconify-json/ri": "^1.1.26",
    "@tanstack/vue-virtual": "^3.10.0",
    "@vueuse/core": "^10.9.0",
    "ant-design-vue": "^4.2.0",
    "axios": "^1.6.7",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "js-cookie": "^3.0.5",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "vue": "^3.4.21",
    "vue-i18n": "^10.0.0",
    "vue-router": "^4.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.10.0",
    "@iconify-json/carbon": "^1.1.30",
    "@playwright/test": "^1.42.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.11.0",
    "@types/nprogress": "^0.2.3",
    "@unocss/eslint-config": "^0.58.0",
    "@unocss/reset": "^0.58.0",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.4",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-format": "^0.1.0",
    "eslint-plugin-vue": "^9.22.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.35",
    "postcss-html": "^1.6.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.2.5",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.71.0",
    "stylelint": "^16.2.0",
    "stylelint-config-recess-order": "^5.0.0",
    "stylelint-config-standard-scss": "^13.0.0",
    "typescript": "^5.3.3",
    "unocss": "^0.58.0",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.1.0",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-mock": "^3.0.1",
    "vite-plugin-pages": "^0.32.0",
    "vite-plugin-vue-devtools": "^7.0.0",
    "vitest": "^1.3.0",
    "vue-tsc": "^1.8.27"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}