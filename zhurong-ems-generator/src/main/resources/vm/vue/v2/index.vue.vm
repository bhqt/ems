<script setup name="${BusinessName}">
import moment from 'moment';
import { getToken } from "@/utils/auth";

import ${businessName} from "@/api/${moduleName}/${businessName}";
import ${businessName}Extend from "@/api/${moduleName}/${businessName}Extend";

import addUpdateDialog from './addUpdateDialog.vue';
import detailDialog from './detailDialog.vue';
import importDialog from './importDialog.vue';
#foreach($gridButton in $gridButtonList)
#if($gridButton.openDialog=="1")
import ${gridButton.functionName}Dialog from './${gridButton.functionName}Dialog.vue';
#end
#end

// 获取组件实例
const instance = getCurrentInstance();
const { proxy } = getCurrentInstance();

// 获取当前日期
const today = new Date();
#if($genTableExtendInfo.queryDateRange && $genTableExtendInfo.queryDateRange != "")
// 设置开始日期
const beginDate = moment(today).add(-${genTableExtendInfo.queryDateRange}, 'hours').format('YYYY-MM-DD');
// 设置开始时间
const beginTime = moment(today).add(-${genTableExtendInfo.queryDateRange}, 'hours').format('YYYY-MM-DD 00:00:00');
#else
// 设置开始日期 默认30天
const beginDate = moment(today).add(-30, 'days').format('YYYY-MM-DD');
// 设置开始时间 默认30天
const beginTime = moment(today).add(-30, 'days').format('YYYY-MM-DD 00:00:00');
#end
// 设置结束日期-今天
const endDate = moment(today).add(0, 'days').format('YYYY-MM-DD');
const endTime = moment(today).add(0, 'days').format('YYYY-MM-DD 23:59:59');
#foreach ($column in $columns)
#if($column.query && $column.htmlType == "date" && $column.queryType == "BETWEEN")
#set($AttrName=$column.attrName)
// 初始化 dateRange${AttrName}
#if($genTableExtendInfo.queryDateRange && $genTableExtendInfo.queryDateRange != "")
const dateRange${AttrName} = ref([beginTime, endTime]);
#else
const dateRange${AttrName} = ref([]);
#end
#end
#if($column.query && $column.htmlType == "datetime" && $column.queryType == "BETWEEN")
#set($AttrName=$column.attrName)
// 初始化 dateRange${AttrName}
#if($genTableExtendInfo.queryDateRange && $genTableExtendInfo.queryDateRange != "")
const dateRange${AttrName} = ref([beginTime, endTime]);
#else
const dateRange${AttrName} = ref([]);
#end
#end
#end

const pageData = reactive({
  dicts: {
#if(${dicts} != '')
#set($dictsNoSymbol=$dicts.replace("'", ""))
#set($dictNames=$dictsNoSymbol.split(","))
#foreach($name in $dictNames)
      $!{name.trim()}: [],
#end
#end
  },
  ${businessName}List: [],
#if($table.sub)
  ${subclassName}List: [],
#end
  loadingListData: true,
  showSearchTool: true,
  selectedIds: [],
  singleSelected: true,
  multipleSelected: true,
  listTotal: 0,
  queryParams: {
    pageNum: 1,
    pageSize: 10,
#foreach ($column in $columns)
#if($column.query)
    $column.javaField: null,
#end
#end
    params: {
#foreach ($column in $columns)
#if($column.query && $column.queryType == "BETWEEN")
#set($AttrName=$column.attrName)
    begin$AttrName: null,
    end$AttrName: null,
#end
#end
    }
  },
  // 默认排序
#if($genTableExtendInfo.tableDefaultOrderByStr)
  defaultSort: {prop: '${genTableExtendInfo.tableDefaultOrderByStr}', order: 'descending'},
#else
  defaultSort: {prop: 'updateTime', order: 'descending'},
#end
  rules: {
    #foreach ($column in $columns)
#if($column.required)
#set($parentheseIndex=$column.columnComment.indexOf("（"))
#if($parentheseIndex != -1)
#set($comment=$column.columnComment.substring(0, $parentheseIndex))
#else
#set($comment=$column.columnComment)
#end
    $column.javaField: [
      { required: true, message: "$comment不能为空", trigger: #if($column.htmlType == "select" || $column.htmlType == "radio")"change"#else"blur"#end }
    ]#if($foreach.count != $columns.size()),#end
#end
#end
  }
});

#foreach($column in $columns)
#set($dictType=$column.dictType)
#if(($column.htmlType == "select" || $column.htmlType == "selectSelfDefine" || $column.htmlType == "radio") && ($column.columnName.indexOf("_2") != -1 ))
##  级联下拉框，2级
#set($index=$column.javaField.indexOf("2"))
#set($prefix=$column.javaField.substring(0, $index))
// 监听第1级选择的变化
watch(() => pageData.queryParams.${prefix}1, (newVal) => {
  pageData.queryParams.${prefix}2 = ''; // 清空下一级选择
  pageData.queryParams.${prefix}3 = '';
  if (newVal) {
    // 过滤第2级字典数组
    // 查询后端自定义级联转码时，返回对应的parentDictValue，通过parentDictValue过滤下级下拉框
	const filteredOptions = pageData.dicts.${column.dictType}.filter(item => {
		// console.log("item", item)
		// console.log("newVal", newVal)
	   // 关键修改：先检查 parentDictValue 是否存在
      return item.parentDictValue != null &&
             item.parentDictValue.toString() === newVal.toString();
	 });
     ${dictType}_options.value = filteredOptions;  } else {
    // 当 newVal 不存在时
    ${dictType}_options.value = [];
  }
});
#elseif(($column.htmlType == "select" || $column.htmlType == "selectSelfDefine" || $column.htmlType == "radio") && ($column.columnName.indexOf("_3") != -1 ))
##  级联下拉框，3级
#set($index=$column.javaField.indexOf("3"))
#set($prefix=$column.javaField.substring(0, $index))
// 监听第2级选择的变化
watch(() => pageData.queryParams.${prefix}2, (newVal) => {
  pageData.queryParams.${prefix}3 = ''; // 清空下一级选择
  if (newVal) {
    // 过滤第3级字典数组
    // 查询后端自定义级联转码时，返回对应的parentDictValue，通过parentDictValue过滤下级下拉框
	const filteredOptions = pageData.dicts.${column.dictType}.value.filter(item => {
		// console.log("item", item)
		// console.log("newVal", newVal)
		return item.parentDictValue.toString() === newVal.toString()
	 });
     ${dictType}_options.value = filteredOptions;  } else {
    // 当 newVal 不存在时
    ${dictType}_options.value = [];
  }
});
