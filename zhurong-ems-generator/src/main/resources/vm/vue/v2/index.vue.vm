  proxy.resetForm("queryFormRef");
  handleQuery();
}

// 多选框选中数据
function handleSelectionChange(selection) {
  pageData.selectedIds = selection.map(item => item.${pkColumn.javaField});
  pageData.singleSelected = selection.length != 1;
  pageData.multipleSelected = !selection.length;
}

/** 新增按钮操作 */
async function handleAdd() {
  // 先获取最新字典数据
  const dicts = await fetchDicts();
  if (dicts) {
  	proxy.#[[$]]#refs.addUpdateDialogRef.open${BusinessName}AddDialog(pageData.queryParams, dicts);
  }
}

/** 修改按钮操作 */
async function handleUpdate(row) {
  // 先获取最新字典数据
  const dicts = await fetchDicts();
  if (dicts) {
  	const id = row.${pkColumn.javaField} || pageData.selectedIds
 	proxy.#[[$]]#refs.addUpdateDialogRef.open${BusinessName}UpdateDialog(id, dicts);
  }
}

/** 删除按钮操作 */
function handleDelete(row) {
  const idsArr = row.${pkColumn.javaField} || pageData.selectedIds;
  proxy.#[[$modal]]#.confirm('确认删除当前选中的记录吗？').then(function() {
    return ${businessName}.delete${BusinessName}ByIds(idsArr);
  }).then(() => {
    getList("delete");
    proxy.#[[$modal]]#.msgSuccess("删除成功");
  }).catch(() => {});
}

/** 清空全部数据按钮操作 */
function handleDeleteAllData(row) {
  // 第一次确认对话框
  proxy.#[[$]]#modal.confirm('警告：此操作将清空全部数据！\n清空后不可恢复！\n确定要继续吗？')
    .then(() => {
      // 第二次确认对话框，要求用户输入确认文本
      return proxy.#[[$]]#modal.prompt('请输入"确认清空"以继续操作：', {
        inputPlaceholder: '确认删除',
        confirmButtonText: '确认',
        cancelButtonText: '取消'
      });
    })
    .then(({ value }) => {
      // 验证用户输入
      if (value.trim() === '确认清空') {
        // 执行删除操作
        return ${businessName}.delete${BusinessName}AllData();
      } else {
        throw new Error('确认文本不正确，操作已取消');
      }
    })
    .then(() => {
      getList("delete");
      proxy.#[[$]]#modal.msgSuccess("清空全部数据成功");
    })
    .catch((error) => {
      if (error === 'cancel') {
        proxy.#[[$]]#modal.msgInfo("清空全部数据操作已取消");
      } else {
        proxy.#[[$]]#modal.msgError(error.message || "清空全部数据操作失败");
      }
    });
}

