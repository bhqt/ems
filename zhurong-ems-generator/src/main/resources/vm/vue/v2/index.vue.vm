/** 查询${functionName}列表 */
function getList(operateFlag) {
  //  主页增删改、导入、其他方法处理成功扩展方法
  ${businessName}Extend.indexOperateSuccessExtend(instance, operateFlag)
  pageData.loadingListData = true;
#foreach ($column in $columns)
#set($AttrName=$column.attrName)
#if($column.query && ($column.htmlType == "date" || $column.htmlType == "datetime") && $column.queryType == "BETWEEN")
  if (dateRange${AttrName}.value !== null && dateRange${AttrName}.value !== '') {
  	pageData.queryParams.params["begin${AttrName}"] = dateRange${AttrName}.value[0];
  	pageData.queryParams.params["end${AttrName}"] = dateRange${AttrName}.value[1];
  } else {
  	pageData.queryParams.params["begin${AttrName}"] = null;
  	pageData.queryParams.params["end${AttrName}"] = null;
  }
#end
#end
  ${businessName}.selectPageList${ClassName}(pageData.queryParams).then(response => {
    pageData.${businessName}List = response.rows;
    pageData.listTotal = response.total;
    pageData.loadingListData = false;
  });
}

/** 排序触发事件 */
function handleSortChange(column, prop, order) {
	pageData.queryParams.orderByColumn = column.prop;
	pageData.queryParams.isAsc = column.order;
	getList();
}

/** 搜索按钮操作 */
function handleQuery() {
  pageData.queryParams.pageNum = 1;
  // 从新设置列表显示的默认排序字段并进行查询，该字段(updateTime)必须在列表中存在，否则sort方法不执行，需要使用下面的selectPageList方法
  proxy.#[[$]]#refs.mainTable.sort(pageData.defaultSort.prop, pageData.defaultSort.order)
  // 上面的sort方法就会进行查询，不需要下面的查询，否则查询执行两次
  // this.selectPageList${ClassName}();
}

/** 重置按钮操作 */
function resetQuery() {
#foreach ($column in $columns)
#set($AttrName=$column.attrName)
#if($column.query && ($column.htmlType == "datetime") && $column.queryType == "BETWEEN")
  dateRange${AttrName}.value = [beginTime, endTime];
#end
#if($column.query && ($column.htmlType == "date") && $column.queryType == "BETWEEN")
  dateRange${AttrName}.value = [beginDate, endDate];
#end
