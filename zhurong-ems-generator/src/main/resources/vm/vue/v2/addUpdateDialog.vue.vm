// 初始化-级联转码-字典数组
const ${dictType}_options = ref([]);
#end
#end

const pageData = reactive({
  dicts: {},
  deptTreeFilterData: null,
  open: false,
  title: "",
  loading: false,
  vueAppBaseApi: import.meta.env.VITE_APP_BASE_API,
  addOrUpdate: "",
  addUpdateForm: {},
  addUpdateFormRules: {
#foreach ($column in $columns)
#if(${pkColumn.javaField}!= $column.javaField)
				// ${column.columnComment}
				$column.javaField: [
#if($column.required)
#set($comment=$column.columnComment)
#if($column.javaType == "Integer" || $column.javaType == "Long")
					{ required: true, message: "$comment不能为空并且为整数", trigger: #if(($column.htmlType == "select" || $column.htmlType == "selectSelfDefine")  || $column.htmlType == "radio")"change"#else"blur"#end },
#elseif($column.javaType == "BigDecimal")
					{ required: true, message: "$comment不能为空并且为数字", trigger: #if(($column.htmlType == "select" || $column.htmlType == "selectSelfDefine")  || $column.htmlType == "radio")"change"#else"blur"#end },
#else
					{ required: true, message: "$comment不能为空", trigger: #if(($column.htmlType == "select" || $column.htmlType == "selectSelfDefine")  || $column.htmlType == "radio")"change"#else"blur"#end },
#end
#end
#if($column.htmlType == "input")
#if($column.javaType == "Integer" || $column.javaType == "Long")
#if($column.columnName.indexOf("bi_li") != -1)
					{validator: proxy.$validateRules.validatePositiveInteger_0_100, trigger: ["blur", "change"]},
#else
					{validator: proxy.$validateRules.validatePositiveInteger, trigger: ["blur", "change"]},
#end
#elseif($column.javaType == "BigDecimal")
					{validator: proxy.$validateRules.validateNumberInRange, trigger: ["blur", "change"]},
#else
#if($column.extend7)
     				{validator: proxy.$validateRules.${column.extend7}, trigger: ["blur", "change"]},
#end
#end
#end
				]#if($foreach.count != $columns.size()),#end
#end
#end
