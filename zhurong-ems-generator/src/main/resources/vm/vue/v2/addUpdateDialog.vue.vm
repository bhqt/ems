});

#foreach($column in $columns)
#set($dictType=$column.dictType)
#if(($column.htmlType == "select" || $column.htmlType == "selectSelfDefine" || $column.htmlType == "radio") && ($column.columnName.indexOf("_2") != -1 ))
##  级联下拉框，2级
#set($index=$column.javaField.indexOf("2"))
#set($prefix=$column.javaField.substring(0, $index))
// 监听第1级选择的变化
watch(() => pageData.addUpdateForm.${prefix}1, (newVal) => {
  if (newVal) {
	 const ${prefix}2_old = pageData.addUpdateForm.${prefix}2;
     // 过滤第2级字典数组
	if (pageData.dicts && pageData.dicts.${dictType}) {
		const filteredOptions = pageData.dicts.${dictType}.filter(item => {
			// console.log("item", item)
			// console.log("newVal", newVal)
			return item.parentDictValue.toString() === newVal.toString()
		});
     	${dictType}_options.value = filteredOptions;
		// 如果之前的 ${prefix}2 在新的选项中，则恢复其值 - 避免修改页面赋值后不能正确显示出来
		if (${prefix}2_old && filteredOptions.some(option => option.value.toString() === ${prefix}2_old.toString())) {
		  pageData.addUpdateForm.${prefix}2 = ${prefix}2_old;
		}else{
			  if (pageData.addUpdateForm.${prefix}2){
				 pageData.addUpdateForm.${prefix}2 = ''; // 清空下一级选择
			  }
		}
	} else {
	  	// 处理数据未加载的情况
	  	${dictType}_options.value = [];
	}
  } else {
    // 当 newVal 不存在时
    ${dictType}_options.value = [];
  }
});
#elseif(($column.htmlType == "select" || $column.htmlType == "selectSelfDefine" || $column.htmlType == "radio") && ($column.columnName.indexOf("_3") != -1 ))
##  级联下拉框，3级
#set($index=$column.javaField.indexOf("3"))
#set($prefix=$column.javaField.substring(0, $index))
// 监听第2级选择的变化
watch(() => pageData.addUpdateForm.${prefix}2, (newVal) => {
  if (newVal) {
	const ${prefix}3_old = pageData.addUpdateForm.${prefix}3;
    // 过滤第3级字典数组
    // 查询后端自定义级联转码时，返回对应的parentDictValue，通过parentDictValue过滤下级下拉框
	const filteredOptions = pageData.dicts.${dictType}.value.filter(item => {
		// console.log("item", item)
		// console.log("newVal", newVal)
		return item.parentDictValue.toString() === newVal.toString()
	 });
     ${dictType}_options.value = filteredOptions;
	// 如果之前的 ${prefix}3 在新的选项中，则恢复其值 - 避免修改页面赋值后不能正确显示出来
      if (${prefix}3_old && filteredOptions.some(option => option.value.toString() === ${prefix}3_old.toString())) {
        pageData.addUpdateForm.${prefix}3 = ${prefix}3_old;
      }else{
		  if(pageData.addUpdateForm.${prefix}3){
			pageData.addUpdateForm.${prefix}3 = ''; // 清空下一级选择
		  }
      }
  } else {
    // 当 newVal 不存在时
    ${dictType}_options.value = [];
  }
});
#end
#end

// 取消按钮
function cancel() {
  pageData.open = false;
  reset();
}

// 表单重置
function reset() {
  pageData.addUpdateForm = {
#foreach ($column in $columns)
#if($column.htmlType == "checkbox")
    $column.javaField: []#if($foreach.count != $columns.size()),#end
#else
    $column.javaField: null#if($foreach.count != $columns.size()),#end
#end
#end
  };
#if($table.sub)
  ${subclassName}List.value = [];
#end
  proxy.resetForm("addUpdateFormRef");
}

/** 打开新增窗口 */
function open${BusinessName}AddDialog(parentQueryParams, dicts) {
  pageData.dicts = dicts
  reset();
  pageData.title = "添加${functionName}";
  pageData.addOrUpdate = "add";
#if($extendInfo && $extendInfo.indexOf("needChildPageDeal") != -1)
  console.log("parentQueryParams.realMainId=", parentQueryParams.realMainId)
  if (parentQueryParams.realMainId) {
    pageData.addUpdateForm.realMainId = Number(parentQueryParams.realMainId);
  }
#end
  ${businessName}Extend.openAddDialogExtend(proxy, parentQueryParams);
  pageData.open = true;
}

/** 打开修改窗口 */
function open${BusinessName}UpdateDialog(${pkColumn.javaField}, dicts) {
 pageData.dicts = dicts
  reset();
  ${businessName}.selectDataByPk${BusinessName}(${pkColumn.javaField}).then(response => {
    pageData.addUpdateForm = response.data;
#foreach ($column in $columns)
#if($column.htmlType == "input-tag" )
  	pageData.addUpdateForm.${column.javaField}InputTagArr = []
  	if (pageData.addUpdateForm.$column.javaField){
  	  	pageData.addUpdateForm.${column.javaField}InputTagArr = pageData.addUpdateForm.${column.javaField}.split(',').map(tag => tag.trim()); // 移除可能存在的多余空格
  	}
#end
#if($column.htmlType == "checkbox")
    pageData.addUpdateForm.$column.javaField = pageData.addUpdateForm.${column.javaField}.split(",");
#end
#end
#if($table.sub)
    ${subclassName}List.value = response.data.${subclassName}List;
#end
    pageData.title = "修改${functionName}";
  	pageData.addOrUpdate = "update";
    pageData.open = true;
  });
}

#foreach ($column in $columns)
#if($column.htmlType == "input-tag" )
// 监听 ${column.javaField}InputTagArr 的变化，以便从数组转回字符串
watch(() => pageData.addUpdateForm.${column.javaField}InputTagArr, (newVal) => {
  // 如果 newVal 是一个数组，则将其连接成字符串，使用逗号作为分隔符
  if (Array.isArray(newVal)) {
    pageData.addUpdateForm.$column.javaField = newVal.join(','); // 明确指定分隔符
  } else {
    pageData.addUpdateForm.$column.javaField = '';
  }
}, { immediate: true }); // 根据需求选择是否需要立即执行
#end
#end

/** 提交按钮 */
function submitForm() {
  proxy.#[[$]]#refs["addUpdateFormRef"].validate(valid => {
    if (valid) {
#foreach ($column in $columns)
#if($column.htmlType == "checkbox")
      pageData.addUpdateForm.$column.javaField = pageData.addUpdateForm.${column.javaField}.join(",");
#end
#end
#if($table.sub)
      pageData.addUpdateForm.${subclassName}List = ${subclassName}List.value;
#end
      if (pageData.addUpdateForm.${pkColumn.javaField} != null) {
		// 修改${functionName}：只能用于前端form表单的更新操作，清空的字段回写为null
        ${businessName}.updateNullValueBy${ClassName}(pageData.addUpdateForm).then(response => {
          proxy.#[[$modal]]#.msgSuccess("修改成功");
          pageData.open = false;
          // 调用父页面刷新列表方法
          proxy.$emit("addUpdateSubmitCallback");
        });
      } else {
        ${businessName}.add${BusinessName}(pageData.addUpdateForm).then(response => {
          proxy.#[[$modal]]#.msgSuccess("新增成功");
          pageData.open = false;
          proxy.$emit("addUpdateSubmitCallback");
        });
      }
    }
  });
}

