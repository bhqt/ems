	@Override
	public List<SysDictData> handleGetDictData(Object params) {
		List<SysDictData> resList = new ArrayList<SysDictData>();
        ${ClassName} queryData = JSONUtil.toBean(JSONUtil.toJsonStr(params), ${ClassName}.class);
		List<${ClassName}> queryList = ${className}Service.selectDataListByEq${ClassName}(queryData);
		for (int i = 0; i < queryList.size(); i++) {
			SysDictData data = new SysDictData();
			data.setDictType(this.dictType);
			// 默认代码值取id
			// 如果存在_code的列，则字典value取该字段
			data.setDictValue(queryList.get(i).get${dictValueStr}() + "");
			// 如果存在_name的列，则字典lable取该字段，否则默认取第二列
			data.setDictLabel(queryList.get(i).get${dictLabelStr}() + "");
#if($selfDefinedDictParentDictValue!="")
			// 设置父级字典id
			data.setParentDictValue(queryList.get(i).get${selfDefinedDictParentDictValue}() + "");
#end
			data.setDictSort((long) (i + 1));
			data.setStatus("0");
			resList.add(data);
		}
		return resList;
	}

	@Override
	public HashMap<String, String> handleGetLableValueMap(Object params) {
        ${ClassName} queryData = JSONUtil.toBean(JSONUtil.toJsonStr(params), ${ClassName}.class);
		HashMap<String, String> map = new HashMap<>();
		List<${ClassName}> list = ${className}Service.selectDataListByEq${ClassName}(queryData);
		for (${ClassName} data : list) {
			map.put(data.get${dictLabelStr}()+"", data.get${dictValueStr}()+"");
		}
		return map;
	}

	@Override
	public String handleGetDictAllLableStr(Object params) {
		StringBuilder res = new StringBuilder();
        ${ClassName} queryData = JSONUtil.toBean(JSONUtil.toJsonStr(params), ${ClassName}.class);
		List<${ClassName}> queryList = ${className}Service.selectDataListByEq${ClassName}(queryData);

		if (!queryList.isEmpty()) {
			for (${ClassName} data : queryList) {
				res.append(data.get${dictLabelStr}()).append(",");
			}
			// 去掉最后一个逗号（如果字符串非空）
			if (res.length() > 0) {
				res.deleteCharAt(res.length() - 1);
			}
		}

		return res.toString();
	}



}
