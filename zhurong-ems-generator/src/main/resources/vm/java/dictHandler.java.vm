{
	private static final Logger logger = LoggerFactory.getLogger(${ClassName}DictHandler.class);

	private final I${ClassName}Service ${className}Service;
	private static final String dictType = "${tableName}";


	// 构造函数注入
	public ${ClassName}DictHandler(I${ClassName}Service ${className}Service) {
		this.${className}Service = ${className}Service;
	}

	@Override
	public boolean supports(String dictType) {
		return this.dictType.equals(dictType);
	}

