<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.PvStationMapper">

    <resultMap type="com.ruoyi.system.domain.vo.PvStationVo" id="PvStationResult">
        <id property="id" column="id"/>
        <result property="stationName" column="station_name"/>
        <result property="stationCode" column="station_code"/>
        <result property="stationType" column="station_type"/>
        <result property="capacity" column="capacity"/>
        <result property="areaId" column="area_id"/>
        <result property="areaName" column="area_name"/>
        <result property="longitude" column="longitude"/>
        <result property="latitude" column="latitude"/>
        <result property="installDate" column="install_date"/>
        <result property="gridDate" column="grid_date"/>
        <result property="designLife" column="design_life"/>
        <result property="componentType" column="component_type"/>
        <result property="inverterModel" column="inverter_model"/>
        <result property="inverterCount" column="inverter_count"/>
        <result property="componentCount" column="component_count"/>
        <result property="status" column="status"/>
        <result property="manager" column="manager"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateBy" column="update_by"/>
    </resultMap>

    <sql id="selectPvStationVo">
        select s.id,
               s.station_name,
               s.station_code,
               s.station_type,
               s.capacity,
               s.area_id,
               d.dept_name as area_name,
               s.longitude,
               s.latitude,
               s.install_date,
               s.grid_date,
               s.design_life,
               s.component_type,
               s.inverter_model,
               s.inverter_count,
               s.component_count,
               s.status,
               s.manager,
               s.contact_phone,
               s.remark,
               s.create_time,
               s.create_by,
               s.update_time,
               s.update_by
        from pv_station s
        left join sys_dept d on s.area_id = d.dept_id
    </sql>

    <select id="selectPvStationList" resultMap="PvStationResult">
        <include refid="selectPvStationVo"/>
        <where>
            s.del_flag = '0'
            <if test="stationName != null and stationName != ''">
                AND s.station_name like concat('%', #{stationName}, '%')
            </if>
            <if test="stationCode != null and stationCode != ''">
                AND s.station_code = #{stationCode}
            </if>
            <if test="stationType != null and stationType != ''">
                AND s.station_type = #{stationType}
            </if>
            <if test="areaId != null">
                AND s.area_id = #{areaId}
            </if>
            <if test="status != null and status != ''">
                AND s.status = #{status}
            </if>
        </where>
        order by s.create_time desc
    </select>

    <select id="selectPvStationById" resultMap="PvStationResult">
        <include refid="selectPvStationVo"/>
        where s.id = #{id}
        and s.del_flag = '0'
    </select>

    <update id="updateStationStatus">
        update pv_station
        set status = #{status},
            update_time = now()
        where id = #{id}
    </update>

</mapper>
